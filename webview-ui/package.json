{
  "name": "manox-webview-ui",
  "version": "0.4.0",
  "private": true,
  "description": "manox sidebar webview \u2014 the v2-native React frontend ported from the manox repo history (apps/web/webui @9c165b25), adapted to the standalone extension host.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs && npx tailwindcss -i src/sidebar/webview/styles/tokens.css -o ../dist/webview/bundle.css --minify",
    "build:js": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "vitest": "^4.1.10"
  }
}